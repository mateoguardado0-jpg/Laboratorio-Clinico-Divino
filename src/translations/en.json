          {
            "nombre": "Renal Profile",
            "requisitos": [
              "Includes: Complete blood count, creatinine, blood urea nitrogen, sodium, potassium, uric acid, general urine test.",
              "Fasting per medical indication (ask at reception)."
            ],
            "tiempoEntrega": "24 hours"
          },
          {
            "nombre": "Coagulation Profile",
            "requisitos": [
              "Includes: Prothrombin time and value, partial thromboplastin time, thrombin time, fibrinogen, platelet count.",
